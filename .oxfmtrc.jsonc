{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"sortImports": true,
	// Lay out objects from their content, not from how they were typed.
	"objectWrap": "collapse",
	"proseWrap": "always",
	"svelte": true,
	// Oxfmt also skips everything in .gitignore.
	// CHANGELOG.md is generated by git-cliff.
	"ignorePatterns": ["pnpm-lock.yaml", "LICENSE", "CHANGELOG.md"],
}
