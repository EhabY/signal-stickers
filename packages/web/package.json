{
	"name": "@signal-stickers/web",
	"version": "0.1.0",
	"private": true,
	"description": "Browser UI for signal-stickers, served by the local server.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"test": "vitest run --project web --root ../..",
		"typecheck": "svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings",
		"watch": "vite build --watch"
	},
	"dependencies": {
		"@signal-stickers/shared": "workspace:*",
		"emoji-picker-element": "catalog:",
		"emoji-picker-element-data": "catalog:",
		"qrcode": "catalog:",
		"upng-js": "catalog:"
	},
	"devDependencies": {
		"@signal-stickers/server": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@testing-library/svelte": "catalog:",
		"@types/qrcode": "catalog:",
		"@types/upng-js": "catalog:",
		"jsdom": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"vite": "catalog:"
	}
}
