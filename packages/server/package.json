{
	"name": "@signal-stickers/server",
	"version": "0.1.0",
	"private": true,
	"description": "Local HTTP and WebSocket API over the signal-stickers engine.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./api": "./src/api.ts"
	},
	"scripts": {
		"dev": "node src/main.ts --port 5174 --allow-origin http://localhost:5173 --no-open",
		"start": "node src/main.ts",
		"test": "vitest run --project server --root ../..",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@signal-stickers/core": "workspace:*",
		"ws": "catalog:"
	},
	"devDependencies": {
		"@types/ws": "catalog:"
	}
}
